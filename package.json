  "description": "Cool Nickname Generator is a simple way to turn plain text into something cool for use, for example, in games.",
  "homepage": "http://iwonz.github.io/cool-nickname-generator",
  "scripts": {
    "start": "node --openssl-legacy-provider ./node_modules/webpack-dev-server/bin/webpack-dev-server.js --host 127.0.0.1",
